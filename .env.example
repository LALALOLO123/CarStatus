# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored and will NOT be committed. This template IS committed.

# Your MyBMW account login (same as the MyBMW app / website)
BMW_USERNAME=your-mybmw-email@example.com
BMW_PASSWORD=your-mybmw-password

# One-time captcha token for the FIRST login only.
# Generate it (North America) at: https://bimmer-connected.readthedocs.io/en/stable/captcha.html
# After a successful login, a refresh token is saved to the "access_token" file,
# so you do NOT need a new captcha token on later runs.
BMW_CAPTCHA_TOKEN=

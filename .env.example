# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored and will NOT be committed. This template IS committed.

# Smartcar app credentials — create an app at https://dashboard.smartcar.com
SMARTCAR_CLIENT_ID=your-smartcar-client-id
SMARTCAR_CLIENT_SECRET=your-smartcar-client-secret

# Must EXACTLY match a Redirect URI registered in your Smartcar dashboard.
SMARTCAR_REDIRECT_URI=http://localhost:8000/callback

# "live" for a real car, "test"/"simulated" for Smartcar's demo vehicles.
SMARTCAR_MODE=live
